# =========================================================
# SentriSense — Environment Variable Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file.
# =========================================================

# ---------- AWS ----------
AWS_REGION=ap-south-1
AWS_PROFILE=sentrisense-dev

# ---------- DynamoDB ----------
TABLE_NAME=SentriSenseAnalyses
DYNAMODB_ENDPOINT=http://localhost:8000
# ^ used only for local DynamoDB Local testing; remove/ignore in cloud deployment

# ---------- S3 ----------
BUCKET_NAME=sentrisense-artifacts-dev
S3_MODELS_PREFIX=models/
S3_UPLOADS_PREFIX=uploads/
S3_RESULTS_PREFIX=results/
S3_REPORTS_PREFIX=reports/

# ---------- Model ----------
MODEL_VERSION=v1.0
MODEL_NAME=tfidf_logreg
MODEL_ARTIFACT_KEY=models/v1.0/sentiment_model.joblib

# ---------- API ----------
API_STAGE=dev
MAX_TEXT_LENGTH=5000
MAX_BATCH_ROWS=2000
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---------- Local backend (Phase 7) ----------
LOCAL_API_PORT=8080

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080

# ---------- Cognito (optional, Phase 19+) ----------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
